# CraftVeda Environment Configuration
# Copy this file to .env and set your database connection parameters

# Option A: REST API Backend URL (Node.js / Express / Django / Laravel / Spring Boot)
VITE_API_BASE_URL=http://localhost:5000/api

# Option B: Supabase Database Credentials (if using Supabase)
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key-here

# Option C: Firebase Credentials (if using Firebase Firestore)
VITE_FIREBASE_API_KEY=your-api-key
VITE_FIREBASE_PROJECT_ID=your-project-id
